    "insight.plateau.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has levelled off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gelişimi yatay seyrediyor"
          }
        }
      }
    },
    "insight.plateau.body %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your estimated 1RM hasn't moved over your last %lld sessions. A lighter week, a different rep range or a bit more rest often gets it moving again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini 1TM'in son %lld antrenmandır değişmedi. Daha hafif bir hafta, farklı bir tekrar aralığı ya da biraz daha dinlenme çoğu zaman yeniden ilerletir."
          }
        }
      }
    },
    "insight.progress_fast.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is climbing quickly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hızla yükseliyor"
          }
        }
      }
    },
    "insight.progress_fast.body %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 1RM is changing %@ a month, ahead of the %@ typical for your level. Nice work."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1TM'in ayda %@ değişiyor; senin seviyende tipik olan %@ oranının önünde. Güzel gidiyor."
          }
        }
      }
    },
    "insight.progress_slow.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is progressing slowly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yavaş ilerliyor"
          }
        }
      }
    },
    "insight.progress_slow.body %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 1RM is changing %@ a month, below the %@ typical for your level. More frequency, volume or recovery can help."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1TM'in ayda %@ değişiyor; senin seviyende tipik olan %@ oranının altında. Daha sık çalışmak, hacmi artırmak ya da daha iyi toparlanmak yardımcı olabilir."
          }
        }
      }
    },
    "insight.neglected_muscle.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ missed this week"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu hafta çalışılmadı"
          }
        }
      }
    },
    "insight.neglected_muscle.body %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You had been training it about %@ sets a week, with none in the last 7 days. One exercise is enough to keep it on track."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaklaşık %@ set çalışıyordun, son 7 günde hiç çalışmadın. Düzeni korumak için bir hareket yeter."
          }
        }
      }
    },
    "insight.push_pull.title.pull_behind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulling work trails your pushing"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekiş çalışman itiş çalışmanın gerisinde"
          }
        }
      }
    },
    "insight.push_pull.title.push_behind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushing work trails your pulling"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtiş çalışman çekiş çalışmanın gerisinde"
          }
        }
      }
    },
    "insight.push_pull.body %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over four weeks: %@ pushing sets against %@ pulling sets. Evening them out keeps your shoulders happy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört haftada: %@ itiş seti, %@ çekiş seti. Dengelemek omuzlarını sağlıklı tutar."
          }
        }
      }
    },
    "insight.comeback.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar hoş geldin"
          }
        }
      }
    },
    "insight.comeback.body %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has been %lld days since your last workout. Start a little lighter and build back up; your strength returns quickly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son antrenmanından bu yana %lld gün geçti. Biraz daha hafif başla ve yavaşça yüklen; gücün hızla geri gelir."
          }
        }
      }
    },
    "insight.bodyweight_stale.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update your weight"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilonu güncelle"
          }
        }
      }
    },
    "insight.bodyweight_stale.body %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last weigh-in was %lld days ago. Scores compare you with people of your weight, so a current number keeps them accurate."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tartın %lld gün önceydi. Skorlar seni kilondaki kişilerle karşılaştırır; güncel bir değer doğruluğu korur."
          }
        }
      }
    },
    "insight.rep_range_stuck.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most sets sit in one rep range"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setlerin çoğu tek bir tekrar aralığında"
          }
        }
      }
    },
    "insight.rep_range_stuck.body.strength %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your recent sets are 1–5 reps. Adding some sets of 6–12 builds muscle and gives your joints a break."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son setlerinin %@ kadarı 1–5 tekrar. 6–12 tekrarlık setler eklemek kası geliştirir ve eklemlerine nefes aldırır."
          }
        }
      }
    },
    "insight.rep_range_stuck.body.hypertrophy %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your recent sets are 6–12 reps. A few heavier sets of 1–5 can push your strength further."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son setlerinin %@ kadarı 6–12 tekrar. 1–5 tekrarlık birkaç ağır set gücünü daha da ileri taşıyabilir."
          }
        }
      }
    },
    "insight.rep_range_stuck.body.endurance %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of your recent sets are 13+ reps. Heavier sets of 5–12 tend to build strength faster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son setlerinin %@ kadarı 13+ tekrar. 5–12 tekrarlık daha ağır setler gücü genelde daha hızlı geliştirir."
          }
        }
      }
    },
