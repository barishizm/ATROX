    },
    "how.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ATROX is not medical advice. Check with a doctor or other health professional before starting a new training program, especially if you have an injury or a health condition."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ATROX tıbbi tavsiye değildir. Yeni bir antrenman programına başlamadan önce, özellikle bir sakatlığın ya da sağlık sorunun varsa, doktoruna ya da bir sağlık uzmanına danış."
          }
        }
      }
    },
    "coach.unavailable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coach is unavailable"
          }
        },
        "tr": {
