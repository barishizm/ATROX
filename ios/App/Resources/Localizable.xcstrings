    "insight.imbalance.ratio.title %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ strength trails your %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gücün %@ gücünün gerisinde"
          }
        }
      }
    },
    "insight.imbalance.ratio.body %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with people like you, your %@ is further behind than your %@. A few extra sets there would even things out."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin gibi kişilere göre %@ gücün, %@ gücünden daha geride. Orada birkaç ek set dengeyi kurar."
          }
        }
      }
    },
    "insight.imbalance.residual.below.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ is lower than your other lifts suggest"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketin diğer hareketlerine göre düşük"
          }
        }
      }
    },
    "insight.imbalance.residual.below.body %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Given your other lifts, your %@ has room to catch up. Giving it extra attention is a good next step."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer hareketlerine bakılırsa %@ hareketinin yetişecek payı var. Ona biraz daha önem vermek iyi bir sonraki adım."
          }
        }
      }
    },
    "insight.imbalance.residual.above.title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ is ahead of your other lifts"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketin diğer hareketlerinin önünde"
          }
        }
      }
    },
    "insight.imbalance.residual.above.body %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ is strong for what your other lifts predict. Bringing the others up would balance your strength."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketin diğerlerinin öngördüğünden güçlü. Diğerlerini yükseltmek gücünü dengeler."
          }
        }
      }
    },
    "insight.imbalance.side.title.left %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your left side is weaker on %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketinde sol tarafın daha zayıf"
          }
        }
      }
    },
    "insight.imbalance.side.title.right %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your right side is weaker on %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketinde sağ tarafın daha zayıf"
          }
        }
      }
    },
    "insight.imbalance.side.body %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two sides differ by %@. Starting sets with the weaker side often helps close the gap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki taraf arasında %@ fark var. Setlere zayıf tarafla başlamak farkı kapatmaya yardım eder."
          }
        }
      }
    },
