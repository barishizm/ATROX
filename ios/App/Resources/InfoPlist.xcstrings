{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX reads your height, weight, birth date, sex and step count from Apple Health to fill in your profile, import weigh-ins and show your steps. They are saved to your ATROX account only to calculate your strength scores, and are never used for advertising or sold."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX, profilini doldurmak ve tartı ölçümlerini almak ve adımlarını göstermek için Apple Sağlık'tan boy, kilo, doğum tarihi, cinsiyet ve adım sayını okur. Bunlar ATROX hesabına yalnızca güç skorlarını hesaplamak için kaydedilir; reklam için kullanılmaz ve satılmaz."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX saves your weigh-ins and workouts to Apple Health."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX, tartı ölçümlerini ve antrenmanlarını Apple Sağlık'a kaydeder."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX uses the camera to photograph your meals for calorie estimates and to scan product barcodes. Photos are only sent for analysis when you tap to analyze."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX, kalori tahmini için yemeklerinin fotoğrafını çekmek ve ürün barkodlarını okumak için kamerayı kullanır. Fotoğraflar yalnızca sen analiz etmeye dokunduğunda analiz için gönderilir."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX uses the microphone only while you dictate what you ate. Nothing is recorded or stored."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX mikrofonu yalnızca ne yediğini sesle anlatırken kullanır. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX turns your voice into text when you dictate a meal, so it can estimate the calories."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATROX, öğününü sesle anlattığında konuşmanı metne çevirir ve kalori tahmini yapar."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
