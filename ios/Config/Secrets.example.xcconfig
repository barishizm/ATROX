// Template. Copy to Secrets.xcconfig (gitignored) and fill in.
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// Only the public `anon` key belongs here — never the service_role key.
// Note: "//" starts a comment in xcconfig, so write URLs as https:/$(SLASH)host.

SLASH = /
SUPABASE_URL = https:/$(SLASH)YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// ---- Google Sign-In (P014) ----
// The iOS OAuth client is tied to ONE bundle ID, so each configuration has its own iOS client.
// The Web client ID belongs to the environment's Supabase project (used as server client ID);
// Debug uses the staging project's web client.
// Reversed client ID = "com.googleusercontent.apps." + the numeric/hash part of the iOS client ID.
GOOGLE_WEB_CLIENT_ID[config=Debug] = YOUR_STAGING_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID[config=Staging] = YOUR_STAGING_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID[config=Release] = YOUR_PROD_WEB_CLIENT_ID.apps.googleusercontent.com

GOOGLE_IOS_CLIENT_ID[config=Debug] = YOUR_DEBUG_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID[config=Debug] = com.googleusercontent.apps.YOUR_DEBUG_IOS_CLIENT_ID

GOOGLE_IOS_CLIENT_ID[config=Staging] = YOUR_STAGING_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID[config=Staging] = com.googleusercontent.apps.YOUR_STAGING_IOS_CLIENT_ID

GOOGLE_IOS_CLIENT_ID[config=Release] = YOUR_PROD_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID[config=Release] = com.googleusercontent.apps.YOUR_PROD_IOS_CLIENT_ID
