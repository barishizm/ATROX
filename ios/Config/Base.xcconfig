// Base.xcconfig — shared by every configuration. Committed; contains no secrets.

// ---- Working name (change ONLY here; bundle IDs and display name derive from it) ----
APP_DISPLAY_NAME = ATROX
APP_BUNDLE_ID_BASE = com.barishizm.atrox

// Per-configuration suffixes (overridden in Debug/Staging/Release.xcconfig)
APP_BUNDLE_ID_SUFFIX =
APP_DISPLAY_NAME_SUFFIX =

PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID_BASE)$(APP_BUNDLE_ID_SUFFIX)
// App group shared with widgets; the local SwiftData store lives in it (docs/02-MIMARI.md §2.3).
APP_GROUP_ID = group.$(APP_BUNDLE_ID_BASE)$(APP_BUNDLE_ID_SUFFIX)
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)$(APP_DISPLAY_NAME_SUFFIX)

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ---- Non-secret environment values (overridden per configuration) ----
APP_ENVIRONMENT = local

// ---- Auth (non-secret; real values go in Secrets.xcconfig, see docs/KURULUM.md) ----
// Deep link scheme. Must match auth.site_url / additional_redirect_urls in supabase/config.toml
// and the redirect URLs in the Supabase dashboards.
APP_URL_SCHEME = atrox
// Placeholders so a fresh clone still generates a valid Info.plist; Secrets.xcconfig overrides them.
GOOGLE_IOS_CLIENT_ID = PLACEHOLDER.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = PLACEHOLDER.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.PLACEHOLDER

// ---- Legal links (welcome screen). Placeholders until P101 publishes the real pages. ----
// "//" starts a comment in xcconfig, so URLs are written as https:/$(SLASH)host.
SLASH = /
LEGAL_TERMS_URL = https:/$(SLASH)example.com/terms
LEGAL_PRIVACY_URL = https:/$(SLASH)example.com/privacy

// ---- Secrets (gitignored). Optional so a fresh clone still builds. ----
#include? "Secrets.xcconfig"

// ---- Entitlements (overridable) ----
APP_ENTITLEMENTS_FILE = App/ATROX.entitlements
WIDGET_ENTITLEMENTS_FILE = Widgets/ATROXWidgets.entitlements

// ---- Personal device overrides (gitignored, optional). See Config/Personal.example.xcconfig. ----
#include? "Personal.xcconfig"
