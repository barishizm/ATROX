// Template for running on your own iPhone with a FREE Apple ID ("Personal Team").
//   cp Config/Personal.example.xcconfig Config/Personal.xcconfig   (gitignored)
// Personal teams cannot use Sign in with Apple, App Groups or HealthKit, so this swaps in an empty
// entitlements file. In this build: no Apple sign-in, no HealthKit; the local store falls back to the app sandbox.
// Email sign-in and everything else work. Do NOT use for TestFlight/App Store builds.

// Your Team ID: Xcode > Settings > Accounts > select team, or developer.apple.com > Membership.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic
APP_ENTITLEMENTS_FILE = App/ATROX-Personal.entitlements
WIDGET_ENTITLEMENTS_FILE = Widgets/ATROXWidgets-Personal.entitlements
// Must be globally unique for a free account; change the suffix if Xcode says the ID is taken.
APP_BUNDLE_ID_BASE = com.barishizm.atrox.personal
